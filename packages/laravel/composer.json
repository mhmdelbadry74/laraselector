{
  "name": "mhmdelbadry74/laraselector-laravel",
  "description": "Local-only Blade source locator",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.1", "illuminate/support": "^10.0|^11.0|^12.0", "illuminate/view": "^10.0|^11.0|^12.0"},
  "require-dev": {"orchestra/testbench": "^8.0|^9.0|^10.0", "phpunit/phpunit": "^10.0|^11.0"},
  "autoload": {"psr-4": {"LaraSelector\\": "src/"}},
  "autoload-dev": {"psr-4": {"BladeLocator\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["LaraSelector\\LaraSelectorServiceProvider"]}},
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable"
}
