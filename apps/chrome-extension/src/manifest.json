{
  "manifest_version": 3,
  "name": "LaraSelector",
  "version": "0.2.0",
  "version_name": "0.2.0 beta 1",
  "description": "Inspect local Laravel pages: open Blade/controller source, see view data, queries, routes, and edit text in place.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "LaraSelector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-selector": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle LaraSelector selection"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
